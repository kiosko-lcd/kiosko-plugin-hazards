{
  "name": "kiosko-plugin-hazards",
  "version": "0.1.1",
  "description": "Official warnings (tsunamis, severe weather) and earthquake reports from CAP feeds (NWS, tsunami.gov, CWA via NCDR, AEMET, Meteoalarm, GDACS) as Kiosko full-screen alerts. Informational, not a substitute for official alerts.",
  "type": "module",
  "license": "MIT",
  "author": "Loksly <info@kioskolcd.dev> (https://kioskolcd.dev)",
  "keywords": [
    "kiosko",
    "kiosko-plugin",
    "lcd",
    "cap",
    "alerts",
    "warnings",
    "tsunami",
    "earthquake",
    "weather"
  ],
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-hazards#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiosko-lcd/kiosko-plugin-hazards.git"
  },
  "bugs": {
    "url": "https://github.com/kiosko-lcd/kiosko-plugin-hazards/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "kiosko": {
    "plugin": "./dist/index.js",
    "id": "hazards",
    "sdk": "^0.2.0",
    "languages": [
      "en",
      "es",
      "de",
      "zh-Hant",
      "zh-Hans",
      "ja"
    ],
    "manifest": "./kiosko-manifest.json"
  },
  "files": [
    "dist",
    "docs",
    "kiosko-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --conditions=source --test \"src/**/*.test.ts\"",
    "check": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@kiosko/sdk": "^0.2.0"
  },
  "devDependencies": {
    "@kiosko/core": "^0.2.1",
    "@kiosko/sdk": "^0.2.1",
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
